---
// projects.astro

import projectItems from './Projects/projectItems';
// リンク先に合わせてボタンの文字を変える（押す前に行き先が分かるように）
// sakuga-button は文字だけなので、アイコンは使わない
function linkKind(url) {
  if (/youtu\.?be/.test(url)) return { label: '動画を見る' };
  if (/unityroom\.com/.test(url)) return { label: 'ブラウザで遊ぶ' };
  if (/apps\.apple\.com/.test(url)) return { label: 'App Storeで見る' };
  return { label: 'サイトを開く' };
}
// タブは横に並ぶだけで折り返さないので、表示は短くする（値は作品の tag と同じ）
const filters = [
  { value: 'all', label: 'すべて' },
  { value: 'Webアプリ', label: 'Web' },
  { value: 'ゲーム', label: 'ゲーム' },
  { value: 'デスクトップアプリ', label: 'デスクトップ' },
  { value: 'モバイルアプリ', label: 'モバイル' },
];
---

<section
  id="projects"
  class="animate-fade-in-up py-16 px-4
         bg-gradient-to-b from-white via-indigo-50 to-white
         dark:bg-gradient-to-b dark:from-gray-900 dark:via-gray-800 dark:to-gray-900
         text-gray-900 dark:text-white
         transition-colors duration-300"
>
<div class="text-center mb-8">
  <h2 class="text-4xl font-bold text-gray-900 dark:text-white">Projects</h2>
  <div class="w-20 h-1 bg-gradient-to-r from-blue-600 to-purple-600 mx-auto mt-2 rounded-full"></div>
</div>

<!-- 絞り込み（sakuga-vfx のタブ） -->
<div class="flex justify-center mb-8 px-4 sk-tabs-scroll">
  <sakuga-tabs id="project-filter" label="作品の種類で絞り込む">
    {filters.map((f) => <option value={f.value}>{f.label}</option>)}
  </sakuga-tabs>
</div>
<p id="project-count" class="sr-only" aria-live="polite"></p>

<div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-2">
  {projectItems.map((project) => {
    const link = linkKind(project.liveDemoUrl);
    return (
    <article class="project-item project-card rounded-2xl overflow-hidden transition-all duration-300 bg-white dark:bg-gray-800 flex flex-col" data-tag={project.tag}>
      <div class={`w-full h-52 sm:h-60 flex-shrink-0 bg-gradient-to-br ${project.gradientFrom} ${project.gradientTo} dark:from-gray-700 dark:to-gray-600 flex items-center justify-center overflow-hidden`}>
        <img src={project.image} alt={`${project.title} の画面`} loading="lazy" decoding="async" class="w-full h-full object-contain" />
      </div>

      <div class="flex-1 p-6 flex flex-col">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <h3 class="text-xl font-bold">{project.title}</h3>
          <span class="px-2 py-0.5 rounded-full text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300">{project.tag}</span>
        </div>
        <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">担当：{project.role}</p>
        <p class="text-sm text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">{project.description}</p>

        <div class="mt-auto">
          <ul class="flex flex-wrap gap-2 mb-4" aria-label="使用技術">
            {project.techStack.map((tech) => (
              <li class="px-2 py-1 rounded text-xs bg-[#f4f4f5] dark:bg-gray-700">{tech}</li>
            ))}
          </ul>

          <div class="flex flex-wrap items-center gap-4 gap-y-5">
            <sakuga-button
              class="card-link"
              data-href={project.liveDemoUrl}
              data-new-tab="1"
            >{link.label}<span class="sr-only">（{project.title}・新しいタブで開きます）</span></sakuga-button>

            {project.videoUrl && (
              <sakuga-button
                variant="secondary"
                class="video-open"
                data-video={project.videoUrl}
                data-poster={project.videoPoster}
                data-title={project.title}
              >紹介動画<span class="sr-only">（{project.title}）</span></sakuga-button>
            )}
            {project.githubUrl && (
              <sakuga-button
                variant="secondary"
                class="card-link"
                data-href={project.githubUrl}
                data-new-tab="1"
              >コード<span class="sr-only">（{project.title} の GitHub・新しいタブで開きます）</span></sakuga-button>
            )}
          </div>
        </div>
      </div>
    </article>
    );
  })}
</div>

<dialog id="video-dialog" aria-label="紹介動画" class="video-dialog p-0 bg-transparent backdrop:bg-black/70">
  <div class="relative">
    <video id="video-player" controls playsinline preload="none" class="block max-h-[85vh] w-auto max-w-[92vw] rounded-xl bg-black"></video>
    <sakuga-button id="video-close" variant="secondary" class="absolute -top-5 -right-4">閉じる</sakuga-button>
  </div>
</dialog>

</section>

<script>
  // 紹介動画：ボタンでページ内のダイアログを開いて再生する
  const vDialog = document.getElementById('video-dialog') as HTMLDialogElement | null;
  const vPlayer = document.getElementById('video-player') as HTMLVideoElement | null;
  document.querySelectorAll<HTMLElement>('.video-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.video;
      if (!src) return;
      // ダイアログが使えないブラウザでは mp4 をそのまま開く
      if (!vDialog || !vPlayer || typeof vDialog.showModal !== 'function') { window.open(src, '_blank', 'noopener'); return; }
      vPlayer.src = src;
      if (btn.dataset.poster) vPlayer.poster = btn.dataset.poster;
      vDialog.setAttribute('aria-label', `${btn.dataset.title ?? ''} の紹介動画`);
      vDialog.showModal();
      vPlayer.play().catch(() => {});
    });
  });
  document.getElementById('video-close')?.addEventListener('click', () => vDialog?.close());
  // 背景（動画の外）を押しても閉じる
  vDialog?.addEventListener('click', (e) => { if (e.target === vDialog) vDialog.close(); });
  vDialog?.addEventListener('close', () => { vPlayer?.pause(); });

  // 作品のリンクボタン：エフェクトを見せてから開く
  document.querySelectorAll<HTMLElement>('.card-link').forEach((btn) => {
    btn.addEventListener('click', () => {
      const href = btn.dataset.href;
      if (!href) return;
      (btn as any).done?.();
      setTimeout(() => window.open(href, '_blank', 'noopener'), 560);
    });
  });
</script>

<script>
  // 絞り込み：sakuga-vfx のタブで切り替える
  const filterTabs = document.getElementById('project-filter');
  const allItems = document.querySelectorAll<HTMLElement>('.project-item');
  const count = document.getElementById('project-count');

  filterTabs?.addEventListener('change', (e) => {
    const filter = (e as CustomEvent).detail.value as string;
    let shown = 0;
    allItems.forEach(item => {
      const hit = filter === 'all' || item.dataset.tag === filter;
      item.classList.toggle('hidden', !hit);
      if (hit) shown++;
    });
    if (count) count.textContent = `${shown}件の作品を表示しています`;
  });
</script>

<style>
  .project-card {
    box-shadow:
      8px 8px 20px #d1d5e0,
      -8px -8px 20px #ffffff;
  }
  .project-card:hover {
    box-shadow:
      12px 12px 28px #d1d5e0,
      -12px -12px 28px #ffffff;
    transform: translateY(-2px);
  }

  :global(.dark) .project-card {
    box-shadow:
      8px 8px 20px #151c28,
      -8px -8px 20px #27324e;
  }
  :global(.dark) .project-card:hover {
    box-shadow:
      12px 12px 28px #151c28,
      -12px -12px 28px #27324e;
    transform: translateY(-2px);
  }
</style>
