---
// projects.astro

import projectItems from './Projects/projectItems';
import { ExternalLink, Gamepad2, Github, PlayCircle, Smartphone } from 'lucide-astro';

// リンク先に合わせてボタンの文字を変える（押す前に行き先が分かるように）
function linkKind(url) {
  if (/youtu\.?be/.test(url)) return { label: '動画を見る', icon: PlayCircle };
  if (/unityroom\.com/.test(url)) return { label: 'ブラウザで遊ぶ', icon: Gamepad2 };
  if (/apps\.apple\.com/.test(url)) return { label: 'App Storeで見る', icon: Smartphone };
  return { label: 'サイトを開く', icon: ExternalLink };
}
const filters = ['すべて', 'Webアプリ', 'ゲーム', 'デスクトップアプリ', 'モバイルアプリ'];
---

<section
  id="projects"
  class="animate-fade-in-up py-16 px-4
         bg-gradient-to-b from-white via-indigo-50 to-white
         dark:bg-gradient-to-b dark:from-gray-900 dark:via-gray-800 dark:to-gray-900
         text-gray-900 dark:text-white
         transition-colors duration-300"
>
<div class="text-center mb-8">
  <h2 class="text-4xl font-bold text-gray-900 dark:text-white">Projects</h2>
  <div class="w-20 h-1 bg-gradient-to-r from-blue-600 to-purple-600 mx-auto mt-2 rounded-full"></div>
</div>

<!-- フィルターボタン -->
<div class="flex justify-center gap-2 sm:gap-3 mb-8 flex-wrap" role="group" aria-label="作品の種類で絞り込む">
  {filters.map((f, i) => (
    <button
      type="button"
      class:list={["filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300", i === 0 ? "bg-blue-600 text-white" : "bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-blue-100 dark:hover:bg-blue-900"]}
      data-filter={i === 0 ? 'all' : f}
      aria-pressed={i === 0 ? 'true' : 'false'}
    >
      {f}
    </button>
  ))}
</div>
<p id="project-count" class="sr-only" aria-live="polite"></p>

<div class="max-w-6xl mx-auto grid gap-6 md:grid-cols-2">
  {projectItems.map((project) => {
    const link = linkKind(project.liveDemoUrl);
    const LinkIcon = link.icon;
    return (
    <article class="project-item project-card rounded-2xl overflow-hidden transition-all duration-300 bg-white dark:bg-gray-800 flex flex-col" data-tag={project.tag}>
      <div class={`w-full h-52 sm:h-60 flex-shrink-0 bg-gradient-to-br ${project.gradientFrom} ${project.gradientTo} dark:from-gray-700 dark:to-gray-600 flex items-center justify-center overflow-hidden`}>
        <img src={project.image} alt={`${project.title} の画面`} loading="lazy" decoding="async" class="w-full h-full object-contain" />
      </div>

      <div class="flex-1 p-6 flex flex-col">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <h3 class="text-xl font-bold">{project.title}</h3>
          <span class="px-2 py-0.5 rounded-full text-xs bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300">{project.tag}</span>
        </div>
        {(project.date || project.venue) && (
          <p class="text-xs text-gray-600 dark:text-gray-400 mb-1">
            {[project.date, project.venue].filter(Boolean).join(" ・ ")}
          </p>
        )}
        <p class="text-xs text-gray-600 dark:text-gray-400 mb-3">担当：{project.role}</p>
        <p class="text-sm text-gray-700 dark:text-gray-300 mb-3 leading-relaxed">{project.description}</p>

        {project.why && (
          <div class="mb-4 pl-3 border-l-[3px] border-orange-400/80">
            <p class="text-[11px] font-bold tracking-wide text-orange-700 dark:text-orange-400 mb-0.5">なぜ作ったか</p>
            <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">{project.why}</p>
          </div>
        )}

        <div class="mt-auto">
          <ul class="flex flex-wrap gap-2 mb-4" aria-label="使用技術">
            {project.techStack.map((tech) => (
              <li class="px-2 py-1 rounded text-xs bg-[#f4f4f5] dark:bg-gray-700">{tech}</li>
            ))}
          </ul>

          <div class="flex flex-wrap items-center gap-3">
            <a
              class="card-link"
              href={project.liveDemoUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label}（${project.title}・新しいタブで開きます）`}
            ><sakuga-button class="card-btn is-primary" aria-hidden="true"
              ><span class="btn-inner"><LinkIcon class="w-4 h-4" aria-hidden="true" />{link.label}</span></sakuga-button></a>

            {project.videoUrl && (
              <sakuga-button
                variant="secondary"
                class="card-btn video-open"
                data-video={project.videoUrl}
                data-poster={project.videoPoster}
                data-title={project.title}
              ><span class="btn-inner"><PlayCircle class="w-4 h-4" aria-hidden="true" />紹介動画</span><span class="sr-only">（{project.title}）</span></sakuga-button>
            )}
            {project.githubUrl && (
              <a
                class="card-link"
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`コード（${project.title} の GitHub・新しいタブで開きます）`}
              ><sakuga-button variant="secondary" class="card-btn" aria-hidden="true"
                ><span class="btn-inner"><Github class="w-4 h-4" aria-hidden="true" />コード</span></sakuga-button></a>
            )}
          </div>
        </div>
      </div>
    </article>
    );
  })}
</div>

<dialog id="video-dialog" aria-label="紹介動画" class="video-dialog p-0 bg-transparent backdrop:bg-black/70">
  <div class="relative">
    <video id="video-player" controls playsinline preload="none" class="block max-h-[85vh] w-auto max-w-[92vw] rounded-xl bg-black"></video>
    <sakuga-button id="video-close" variant="secondary" class="absolute -top-5 -right-4">閉じる</sakuga-button>
  </div>
</dialog>

</section>

<script>
  // 紹介動画：ボタンでページ内のダイアログを開いて再生する
  const vDialog = document.getElementById('video-dialog') as HTMLDialogElement | null;
  const vPlayer = document.getElementById('video-player') as HTMLVideoElement | null;
  document.querySelectorAll<HTMLElement>('.video-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.dataset.video;
      if (!src) return;
      // ダイアログが使えないブラウザでは mp4 をそのまま開く
      if (!vDialog || !vPlayer || typeof vDialog.showModal !== 'function') { window.open(src, '_blank', 'noopener'); return; }
      vPlayer.src = src;
      if (btn.dataset.poster) vPlayer.poster = btn.dataset.poster;
      vDialog.setAttribute('aria-label', `${btn.dataset.title ?? ''} の紹介動画`);
      vDialog.showModal();
      vPlayer.play().catch(() => {});
    });
  });
  document.getElementById('video-close')?.addEventListener('click', () => vDialog?.close());
  // 背景（動画の外）を押しても閉じる
  vDialog?.addEventListener('click', (e) => { if (e.target === vDialog) vDialog.close(); });
  vDialog?.addEventListener('close', () => { vPlayer?.pause(); });

  // 作品のリンク：中身は見た目だけの sakuga-button で、外側は本物の <a>。
  // 右クリック・中クリック・⌘クリック・検索エンジンのたどりは <a> のまま効く。
  // ふつうの左クリックのときだけ、エフェクトを見せてから開く。
  document.querySelectorAll<HTMLAnchorElement>('a.card-link').forEach((a) => {
    const btn = a.querySelector('sakuga-button') as HTMLElement | null;
    // 中のボタンは Tab で止まらないようにする（<a> とで二重に止まるのを防ぐ）
    customElements.whenDefined('sakuga-button').then(() => {
      const inner = (btn as any)?.shadowRoot?.querySelector('button');
      if (inner) inner.tabIndex = -1;
    });
    a.addEventListener('click', (e) => {
      // 新しいタブで開く操作はブラウザに任せる
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
      e.preventDefault();
      (btn as any)?.done?.();
      setTimeout(() => window.open(a.href, '_blank', 'noopener'), 560);
    });
  });
</script>

<script>
  // 絞り込み：押したボタンの種類だけ残す
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const allItems = document.querySelectorAll<HTMLElement>('.project-item');
  const count = document.getElementById('project-count');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('bg-blue-600', on);
        b.classList.toggle('text-white', on);
        b.classList.toggle('bg-gray-200', !on);
        b.classList.toggle('dark:bg-gray-700', !on);
        b.classList.toggle('text-gray-700', !on);
        b.classList.toggle('dark:text-gray-300', !on);
      });
      const filter = btn.dataset.filter;
      let shown = 0;
      allItems.forEach((item) => {
        const hit = filter === 'all' || item.dataset.tag === filter;
        item.classList.toggle('hidden', !hit);
        if (hit) shown++;
      });
      if (count) count.textContent = `${shown}件の作品を表示しています`;
    });
  });
</script>

<style>
  .project-card {
    box-shadow:
      8px 8px 20px #d1d5e0,
      -8px -8px 20px #ffffff;
  }
  .project-card:hover {
    box-shadow:
      12px 12px 28px #d1d5e0,
      -12px -12px 28px #ffffff;
    transform: translateY(-2px);
  }

  :global(.dark) .project-card {
    box-shadow:
      8px 8px 20px #151c28,
      -8px -8px 20px #27324e;
  }
  :global(.dark) .project-card:hover {
    box-shadow:
      12px 12px 28px #151c28,
      -12px -12px 28px #27324e;
    transform: translateY(-2px);
  }
</style>
