---
// スケッチ風テーマのアイコン。黄色い丸の中で、アンテナのある白いキャラクターが寝そべっている絵。
// 太い黒の線（インク）＋クリーム色の体。元の画像の代わりに表示する（sketch.css 参照）。
// 塗り（.sa-fill）と線（.sa-line, pathLength=1）を分けてあるので、鉛筆の演出で「線を描いてから塗る」ができる。
const CREAM = '#fffaf0';
const YELLOW = '#fce588';

// 体の各パーツ（奥から順に）：塗りの形と、輪郭の線は同じパス
const parts = [
  // 後ろの足（左に少しはみ出したふくらみ）
  'M58 124 C 40 122, 28 136, 31 150 C 33 160, 44 166, 58 163',
  // 体
  'M50 150 C 44 112, 64 82, 100 76 C 139 70, 167 96, 166 130 C 166 151, 152 162, 130 164 L 74 166 C 60 166, 52 161, 50 150 Z',
  // 前の手（左）
  'M79 168 C 74 146, 111 143, 114 165 C 115 175, 82 177, 79 168 Z',
  // 前の手（右）
  'M127 164 C 123 143, 159 140, 163 159 C 165 170, 130 173, 127 164 Z',
];
// アンテナ（茎）は線だけ
const stalk = 'M90 79 C 88 70, 84 64, 77 60';
// 指の線・ほっぺの斜線・勢いの線
const details = [
  'M92 163 L 92 168', 'M100 163 L 100 168', // 左手の指
  'M140 159 L 140 164', 'M148 158 L 148 163', // 右手の指
  'M74 133 L 71 141', 'M80 133 L 77 141', // 左のほっぺ
  'M126 118 L 131 124', 'M132 115 L 137 121', // 右のほっぺ
  'M30 78 L 41 89', 'M22 99 L 37 104', 'M24 121 L 37 116', // 左の勢いの線
  'M168 102 L 181 95', 'M170 118 L 184 117', // 右の勢いの線
];
// キラッ（4つ角の星）
const sparkle = 'M161 52 Q 163 61, 172 63 Q 163 65, 161 74 Q 159 65, 150 63 Q 159 61, 161 52 Z';
// 三角の口
const mouth = 'M96 111 L 117 109 L 103 128 Z';
---

<svg class="sketch-avatar w-28 h-28" viewBox="0 0 200 200" role="img" aria-label="Kopo-k のアイコン（アンテナのある白いキャラクター）">
  <!-- 背景の黄色い丸 -->
  <circle class="sa-fill" cx="100" cy="100" r="100" fill={YELLOW} />
  <!-- 床の影 -->
  <ellipse class="sa-fill" cx="104" cy="168" rx="66" ry="7" fill="#000" opacity="0.08" />

  <!-- 塗り（クリーム色） -->
  <g class="sa-fill" fill={CREAM}>
    {parts.map((d) => <path d={d} />)}
    <circle cx="70" cy="50" r="11" />
    <path d={mouth} />
  </g>

  <!-- 輪郭の線（手描き風に少しゆらす） -->
  <g fill="none" stroke="#1f1d1a" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" style="filter: url(#sketchy)">
    {parts.map((d) => <path class="sa-line" d={d} pathLength="1" />)}
    <path class="sa-line" d={stalk} pathLength="1" />
    <circle class="sa-line" cx="70" cy="50" r="11" pathLength="1" />
    <path class="sa-line" d={mouth} pathLength="1" stroke-width="4.2" />
    <path class="sa-line" d={sparkle} pathLength="1" stroke-width="3.6" />
    {details.map((d) => <path class="sa-line" d={d} pathLength="1" stroke-width="3.4" />)}
  </g>

  <!-- 目 -->
  <circle class="sa-fill" cx="81" cy="119" r="6.5" fill="#1f1d1a" />
  <circle class="sa-fill" cx="128" cy="105" r="6.5" fill="#1f1d1a" />
</svg>
