---
// ヒーローの背景に描くジェネラティブアート（お試し）。右下のボタンで4種類を切り替える。
// URL に ?bg=flow / particles / voronoi / fractal を付けても選べる。
const MODES = [
  { key: 'sketch', label: 'スケッチ' },
  { key: 'flow', label: 'ノイズ' },
  { key: 'particles', label: 'パーティクル' },
  { key: 'voronoi', label: 'ボロノイ' },
  { key: 'fractal', label: 'フラクタル' },
];
---

<canvas id="gen-bg" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
<!-- 文字を読みやすくするための薄い幕（中央ほど濃い） -->
<div class="gen-veil absolute inset-0 pointer-events-none" aria-hidden="true"></div>

<div
  class="absolute top-3 right-3 z-20 flex flex-wrap justify-end max-w-[calc(100%-1.5rem)] gap-1 rounded-2xl bg-white/75 dark:bg-gray-900/75 backdrop-blur px-2 py-1.5 shadow"
  role="group"
  aria-label="背景のデザイン（お試し）"
>
  {MODES.map((m) => (
    <button
      type="button"
      data-bg={m.key}
      aria-pressed="false"
      class="bg-btn px-2.5 py-1 rounded-full text-xs font-medium text-gray-700 dark:text-gray-300 hover:bg-indigo-100 dark:hover:bg-gray-700 aria-pressed:bg-indigo-600 aria-pressed:text-white transition-colors"
    >
      {m.label}
    </button>
  ))}
</div>

<style>
  .gen-veil {
    background: radial-gradient(ellipse 60% 55% at 50% 52%, rgba(248, 250, 252, 0.82) 0%, rgba(248, 250, 252, 0.45) 55%, rgba(248, 250, 252, 0) 100%);
  }
  :global(.sketch) .gen-veil {
    background: radial-gradient(ellipse 58% 52% at 50% 52%, rgba(251, 247, 238, 0.85) 0%, rgba(251, 247, 238, 0.4) 60%, rgba(251, 247, 238, 0) 100%);
  }
  :global(.sketch.dark) .gen-veil {
    background: radial-gradient(ellipse 58% 52% at 50% 52%, rgba(31, 39, 35, 0.85) 0%, rgba(31, 39, 35, 0.4) 60%, rgba(31, 39, 35, 0) 100%);
  }
  :global(.dark) .gen-veil {
    background: radial-gradient(ellipse 60% 55% at 50% 52%, rgba(17, 24, 39, 0.8) 0%, rgba(17, 24, 39, 0.4) 55%, rgba(17, 24, 39, 0) 100%);
  }
</style>

<script>
  type Mode = 'sketch' | 'flow' | 'particles' | 'voronoi' | 'fractal';
  type RGB = [number, number, number];

  const canvas = document.getElementById('gen-bg') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.bg-btn'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const TAU = Math.PI * 2;

  // ---- 色（テーマに合わせる） --------------------------------------------
  const isDark = () => document.documentElement.classList.contains('dark');
  const pal = () =>
    isDark()
      ? { bg: [17, 24, 39] as RGB, a: [99, 102, 241] as RGB, b: [168, 85, 247] as RGB, c: [56, 189, 248] as RGB }
      : { bg: [248, 250, 252] as RGB, a: [99, 102, 241] as RGB, b: [168, 85, 247] as RGB, c: [59, 130, 246] as RGB };
  const mix = (p: RGB, q: RGB, t: number): RGB => [p[0] + (q[0] - p[0]) * t, p[1] + (q[1] - p[1]) * t, p[2] + (q[2] - p[2]) * t];
  const rgba = (c: RGB, a: number) => `rgba(${c[0] | 0},${c[1] | 0},${c[2] | 0},${a})`;
  /** 3色のグラデーション上の位置 t（0〜1）の色 */
  const ramp = (t: number) => {
    const P = pal();
    t = Math.min(1, Math.max(0, t));
    return t < 0.5 ? mix(P.a, P.c, t * 2) : mix(P.c, P.b, (t - 0.5) * 2);
  };

  // ---- パーリンノイズ（2D） ------------------------------------------------
  const perm = new Uint8Array(512);
  {
    const p = Array.from({ length: 256 }, (_, i) => i);
    for (let i = 255; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [p[i], p[j]] = [p[j], p[i]];
    }
    for (let i = 0; i < 512; i++) perm[i] = p[i & 255];
  }
  const fade = (t: number) => t * t * t * (t * (t * 6 - 15) + 10);
  const lerp = (t: number, a: number, b: number) => a + t * (b - a);
  const grad = (h: number, x: number, y: number) => {
    const g = h & 7;
    const u = g < 4 ? x : y;
    const v = g < 4 ? y : x;
    return ((g & 1) ? -u : u) + ((g & 2) ? -v : v);
  };
  function noise(x: number, y: number) {
    const X = Math.floor(x) & 255;
    const Y = Math.floor(y) & 255;
    x -= Math.floor(x);
    y -= Math.floor(y);
    const u = fade(x);
    const v = fade(y);
    const a = perm[X] + Y;
    const b = perm[X + 1] + Y;
    return lerp(v, lerp(u, grad(perm[a], x, y), grad(perm[b], x - 1, y)), lerp(u, grad(perm[a + 1], x, y - 1), grad(perm[b + 1], x - 1, y - 1)));
  }

  // ---- 共通：大きさ・ポインター ----------------------------------------------
  let W = 0;
  let H = 0;
  let DPR = 1;
  const pointer = { x: -9999, y: -9999 };
  function resize() {
    if (!canvas || !ctx) return;
    const r = canvas.getBoundingClientRect();
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = Math.max(1, Math.round(r.width));
    H = Math.max(1, Math.round(r.height));
    canvas.width = Math.round(W * DPR);
    canvas.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  }

  /** 低解像度の画像を作って拡大して描く（ボロノイ・フラクタル用） */
  const off = document.createElement('canvas');
  const offCtx = off.getContext('2d')!;
  function blitLowRes(scale: number, paint: (img: ImageData, w: number, h: number) => void) {
    if (!ctx) return;
    const w = Math.max(1, Math.ceil(W / scale));
    const h = Math.max(1, Math.ceil(H / scale));
    if (off.width !== w || off.height !== h) {
      off.width = w;
      off.height = h;
    }
    const img = offCtx.createImageData(w, h);
    paint(img, w, h);
    offCtx.putImageData(img, 0, 0);
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(off, 0, 0, W, H);
  }

  // ---- 1. ノイズの流れ場 --------------------------------------------------
  // 通常は色の線が流れる。スケッチ風テーマのときは、紙の上に鉛筆（黒板ならチョーク）で描いた線にする
  const flow = (() => {
    let ps: { x: number; y: number; life: number; accent: boolean; w: number }[] = [];
    const sketchy = () => document.documentElement.classList.contains('sketch');
    const spawn = () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      life: 60 + Math.random() * 240,
      accent: Math.random() < 0.06,
      w: 0.5 + Math.random() * 0.9,
    });
    return {
      init() {
        const n = sketchy() ? Math.min(700, Math.round((W * H) / 1800)) : Math.min(1400, Math.round((W * H) / 900));
        ps = Array.from({ length: n }, spawn);
        if (sketchy()) ctx!.clearRect(0, 0, W, H); // 紙の質感を透かす
        else {
          ctx!.fillStyle = rgba(pal().bg, 1);
          ctx!.fillRect(0, 0, W, H);
        }
      },
      frame(t: number) {
        const s = 0.0022;
        if (sketchy()) {
          // 消しゴムでこするように、古い線を少しずつ薄くする（透明に戻す）
          ctx!.save();
          ctx!.globalCompositeOperation = 'destination-out';
          ctx!.fillStyle = 'rgba(0,0,0,0.018)';
          ctx!.fillRect(0, 0, W, H);
          ctx!.restore();
          const ink = isDark() ? '238,240,234' : '45,42,38';
          const accent = isDark() ? '255,169,77' : '232,89,12';
          ctx!.lineCap = 'round';
          for (const p of ps) {
            const ang = noise(p.x * s, p.y * s + t * 0.00006) * TAU * 1.6;
            const nx = p.x + Math.cos(ang) * 1.8;
            const ny = p.y + Math.sin(ang) * 1.8;
            const col = p.accent ? accent : ink;
            // 鉛筆らしく、少しずらして濃淡2回なぞる（粒子ごとに太さが違う）
            for (let k = 0; k < 2; k++) {
              const jx = (Math.random() - 0.5) * 0.9;
              const jy = (Math.random() - 0.5) * 0.9;
              ctx!.strokeStyle = `rgba(${col},${k === 0 ? 0.16 : 0.07})`;
              ctx!.lineWidth = p.w * (k === 0 ? 1 : 1.8);
              ctx!.beginPath();
              ctx!.moveTo(p.x + jx, p.y + jy);
              ctx!.lineTo(nx + jx, ny + jy);
              ctx!.stroke();
            }
            p.x = nx;
            p.y = ny;
            if (--p.life < 0 || nx < 0 || nx > W || ny < 0 || ny > H) Object.assign(p, spawn());
          }
          return;
        }
        const P = pal();
        ctx!.fillStyle = rgba(P.bg, 0.05); // 前の線を少しずつ消して、残像の尾にする
        ctx!.fillRect(0, 0, W, H);
        ctx!.lineWidth = 1;
        for (const p of ps) {
          const ang = noise(p.x * s, p.y * s + t * 0.00008) * TAU * 1.6;
          const nx = p.x + Math.cos(ang) * 1.4;
          const ny = p.y + Math.sin(ang) * 1.4;
          ctx!.strokeStyle = rgba(ramp(p.x / W), isDark() ? 0.55 : 0.45);
          ctx!.beginPath();
          ctx!.moveTo(p.x, p.y);
          ctx!.lineTo(nx, ny);
          ctx!.stroke();
          p.x = nx;
          p.y = ny;
          if (--p.life < 0 || nx < 0 || nx > W || ny < 0 || ny > H) Object.assign(p, spawn());
        }
      },
    };
  })();

  // ---- 2. パーティクルのつながり --------------------------------------------
  const particles = (() => {
    let ps: { x: number; y: number; vx: number; vy: number }[] = [];
    const LINK = 130;
    return {
      init() {
        const n = Math.min(110, Math.max(30, Math.round((W * H) / 11000)));
        ps = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5 }));
      },
      frame() {
        ctx!.clearRect(0, 0, W, H);
        for (const p of ps) {
          // ポインターから少し逃げる
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 140 * 140 && d2 > 1) {
            const f = (1 - Math.sqrt(d2) / 140) * 0.6;
            p.vx += (dx / Math.sqrt(d2)) * f;
            p.vy += (dy / Math.sqrt(d2)) * f;
          }
          p.vx *= 0.97;
          p.vy *= 0.97;
          p.vx += (Math.random() - 0.5) * 0.04;
          p.vy += (Math.random() - 0.5) * 0.04;
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > W) p.vx *= -1;
          if (p.y < 0 || p.y > H) p.vy *= -1;
          p.x = Math.min(W, Math.max(0, p.x));
          p.y = Math.min(H, Math.max(0, p.y));
        }
        for (let i = 0; i < ps.length; i++) {
          for (let j = i + 1; j < ps.length; j++) {
            const a = ps[i];
            const b = ps[j];
            const d = Math.hypot(a.x - b.x, a.y - b.y);
            if (d < LINK) {
              ctx!.strokeStyle = rgba(ramp((a.x + b.x) / 2 / W), (1 - d / LINK) * 0.45);
              ctx!.lineWidth = 1;
              ctx!.beginPath();
              ctx!.moveTo(a.x, a.y);
              ctx!.lineTo(b.x, b.y);
              ctx!.stroke();
            }
          }
        }
        for (const p of ps) {
          ctx!.fillStyle = rgba(ramp(p.x / W), 0.85);
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, 2.2, 0, TAU);
          ctx!.fill();
        }
      },
    };
  })();

  // ---- 3. ボロノイ図 ----------------------------------------------------
  const voronoi = (() => {
    let seeds: { x: number; y: number; ph: number; sp: number; col: number }[] = [];
    return {
      init() {
        const n = Math.min(26, Math.max(12, Math.round((W * H) / 60000)));
        seeds = Array.from({ length: n }, () => ({ x: Math.random(), y: Math.random(), ph: Math.random() * TAU, sp: 0.15 + Math.random() * 0.25, col: Math.random() }));
      },
      frame(t: number) {
        const P = pal();
        const time = t * 0.0002;
        const pts = seeds.map((s) => ({
          x: (s.x + Math.sin(time * s.sp * 3 + s.ph) * 0.06) * W,
          y: (s.y + Math.cos(time * s.sp * 2.3 + s.ph) * 0.06) * H,
          col: ramp(s.col),
        }));
        const scale = 5;
        blitLowRes(scale, (img, w, h) => {
          const d = img.data;
          for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
              const px = x * scale;
              const py = y * scale;
              let d1 = Infinity;
              let d2 = Infinity;
              let k = 0;
              for (let i = 0; i < pts.length; i++) {
                const dx = pts[i].x - px;
                const dy = pts[i].y - py;
                const dd = dx * dx + dy * dy;
                if (dd < d1) {
                  d2 = d1;
                  d1 = dd;
                  k = i;
                } else if (dd < d2) d2 = dd;
              }
              const edge = Math.sqrt(d2) - Math.sqrt(d1); // 境界からの距離
              const c = pts[k].col;
              const shade = Math.min(1, Math.sqrt(d1) / 260); // 中心ほど明るく
              const fill = mix(c, P.bg, 0.55 + shade * 0.3);
              const line = edge < 2.2 * scale ? 1 - edge / (2.2 * scale) : 0;
              const out = mix(fill, c, line * 0.9);
              const o = (y * w + x) * 4;
              d[o] = out[0];
              d[o + 1] = out[1];
              d[o + 2] = out[2];
              d[o + 3] = 255;
            }
          }
        });
      },
    };
  })();

  // ---- 4. フラクタル（ジュリア集合） -----------------------------------------
  const fractal = (() => {
    const MAX = 64;
    return {
      init() {},
      frame(t: number) {
        const P = pal();
        // 枝が細く伸びる見栄えのよい範囲（角度 2.1〜2.8 付近）だけをゆっくり往復する
        const a = 2.45 + 0.35 * Math.sin(t * 0.00012);
        const cr = 0.7885 * Math.cos(a);
        const ci = 0.7885 * Math.sin(a);
        const scale = W > 900 ? 4 : 3;
        blitLowRes(scale, (img, w, h) => {
          const d = img.data;
          const zoom = 1.6 / Math.min(w, h);
          for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
              let zr = (x - w / 2) * zoom * 1.4;
              let zi = (y - h / 2) * zoom * 1.4;
              let i = 0;
              while (i < MAX && zr * zr + zi * zi < 4) {
                const tr = zr * zr - zi * zi + cr;
                zi = 2 * zr * zi + ci;
                zr = tr;
                i++;
              }
              const o = (y * w + x) * 4;
              let col: RGB;
              if (i >= MAX) col = mix(P.b, P.bg, 0.15);
              else {
                // 外側ほど背景色、集合の縁に近いほど濃い色
                const v = i / MAX;
                col = mix(P.bg, ramp(v * 1.6), Math.min(1, v * 3));
              }
              d[o] = col[0];
              d[o + 1] = col[1];
              d[o + 2] = col[2];
              d[o + 3] = 255;
            }
          }
        });
      },
    };
  })();

  // ---- 0. 鉛筆の落書き（スケッチ） -----------------------------------------
  // ぐるぐる・星・矢印・雲などを、鉛筆でその場で描いていき、しばらくしたら消しゴムで消して描き直す
  const sketch = (() => {
    type Pt = [number, number];
    type Doodle = { lines: Pt[][]; li: number; pi: number; w: number; accent: boolean };
    let doodles: Doodle[] = [];
    let cur = 0;
    let hold = 0;
    let erase = 0;
    const j = (a: number) => (Math.random() - 0.5) * a;
    const ink = () => (isDark() ? '238,240,234' : '45,42,38');
    const accent = () => (isDark() ? '255,169,77' : '232,89,12');

    // 今の組で、すでに置いた落書きの中心（重ならないように離す）
    let used: Pt[] = [];
    function place(): Pt {
      const narrow = W < 640;
      const gap = narrow ? 80 : 125;
      let best: Pt = [Math.random() * W, Math.random() * H * 0.25];
      let bestD = -1;
      for (let k = 0; k < 60; k++) {
        const x = 40 + Math.random() * (W - 80);
        const y = 40 + Math.random() * (H - 80);
        // 文字のある中央は避ける。幅が狭い画面では、文字が横いっぱいに並ぶので真ん中の帯をまるごと避ける
        const inCenter = narrow ? y > H * 0.24 && y < H * 0.9 : x > W * 0.22 && x < W * 0.78 && y > H * 0.28 && y < H * 0.82;
        if (inCenter) continue;
        const d = used.reduce((m, [ux, uy]) => Math.min(m, Math.hypot(ux - x, uy - y)), Infinity);
        if (d >= gap) { best = [x, y]; break; }
        if (d > bestD) { bestD = d; best = [x, y]; }
      }
      used.push(best);
      return best;
    }
    // ---- 好きなもの・やっていることの落書き（ゲーム／映画鑑賞／アプリ開発／読書） ----
    // どれも線（点の並び）の集まりとして作り、鉛筆が順番になぞる
    const seg = (a: Pt, b: Pt, n = 6): Pt[] =>
      Array.from({ length: n + 1 }, (_, i) => [a[0] + ((b[0] - a[0]) * i) / n + j(0.6), a[1] + ((b[1] - a[1]) * i) / n + j(0.6)] as Pt);
    const poly = (pts: Pt[], close = true): Pt[] => {
      const out: Pt[] = [];
      const list = close ? [...pts, pts[0]] : pts;
      for (let k = 1; k < list.length; k++) out.push(...seg(list[k - 1], list[k]).slice(k === 1 ? 0 : 1));
      return out;
    };
    const circ = (cx: number, cy: number, r: number, turns = 1.05, n = 28): Pt[] =>
      Array.from({ length: n + 1 }, (_, i) => {
        const t = -Math.PI / 2 + (i / n) * TAU * turns;
        return [cx + Math.cos(t) * r + j(r * 0.06), cy + Math.sin(t) * r + j(r * 0.06)] as Pt;
      });
    /** 角の丸い四角 */
    const rrect = (x: number, y: number, w: number, h: number, r: number): Pt[] => {
      const pts: Pt[] = [];
      const corner = (cx: number, cy: number, a0: number) => {
        for (let k = 0; k <= 4; k++) {
          const t = a0 + (k / 4) * (Math.PI / 2);
          pts.push([cx + Math.cos(t) * r, cy + Math.sin(t) * r]);
        }
      };
      corner(x + w - r, y + r, -Math.PI / 2);
      corner(x + w - r, y + h - r, 0);
      corner(x + r, y + h - r, Math.PI / 2);
      corner(x + r, y + r, Math.PI);
      return poly(pts);
    };

    const DOODLES: ((cx: number, cy: number, s: number) => Pt[][])[] = [
      // ゲーム：コントローラー（本体・十字キー・ボタン2つ）
      (cx, cy, s) => [
        rrect(cx - s * 1.1, cy - s * 0.5, s * 2.2, s * 1.0, s * 0.45),
        poly([[cx - s * 0.75, cy], [cx - s * 0.35, cy]], false),
        poly([[cx - s * 0.55, cy - s * 0.2], [cx - s * 0.55, cy + s * 0.2]], false),
        circ(cx + s * 0.45, cy - s * 0.1, s * 0.11, 1.05, 10),
        circ(cx + s * 0.72, cy + s * 0.1, s * 0.11, 1.05, 10),
      ],
      // ゲーム：ドット絵風のハート（角ばった輪郭）
      (cx, cy, s) => {
        const u = s * 0.18;
        const p: [number, number][] = [[0, -2], [-1, -3], [-2, -3], [-3, -2], [-3, 0], [-2, 1], [-1, 2], [0, 3], [1, 2], [2, 1], [3, 0], [3, -2], [2, -3], [1, -3]];
        return [poly(p.map(([a, b]) => [cx + a * u, cy + b * u] as Pt))];
      },
      // 映画：カチンコ（板・上の拍子木・斜めの縞）
      (cx, cy, s) => {
        const x = cx - s * 0.9, y = cy - s * 0.35, w = s * 1.8, h = s * 1.1;
        const lines: Pt[][] = [poly([[x, y], [x + w, y], [x + w, y + h], [x, y + h]])];
        lines.push(poly([[x, y - s * 0.05], [x + w, y - s * 0.32], [x + w, y - s * 0.6], [x, y - s * 0.33]]));
        for (let k = 1; k < 5; k++) lines.push(poly([[x + (w * k) / 5 - s * 0.08, y - s * 0.07 - (s * 0.27 * k) / 5], [x + (w * k) / 5 + s * 0.12, y - s * 0.33 - (s * 0.27 * k) / 5]], false));
        lines.push(poly([[x + s * 0.2, y + h * 0.45], [x + w - s * 0.2, y + h * 0.45]], false));
        return lines;
      },
      // 映画：フィルム（帯と、上下の穴）
      (cx, cy, s) => {
        const w = s * 2.2, h = s * 0.9, x = cx - w / 2, y = cy - h / 2;
        const lines: Pt[][] = [poly([[x, y], [x + w, y], [x + w, y + h], [x, y + h]])];
        for (let k = 0; k < 6; k++) {
          const hx = x + s * 0.15 + k * (w - s * 0.3) / 5.5;
          lines.push(poly([[hx, y + s * 0.08], [hx + s * 0.16, y + s * 0.08], [hx + s * 0.16, y + s * 0.2], [hx, y + s * 0.2]]));
          lines.push(poly([[hx, y + h - s * 0.2], [hx + s * 0.16, y + h - s * 0.2], [hx + s * 0.16, y + h - s * 0.08], [hx, y + h - s * 0.08]]));
        }
        return lines;
      },
      // 映画：ポップコーン（カップ・縞・もこもこ）
      (cx, cy, s) => {
        const top = cy - s * 0.2, bot = cy + s * 0.9;
        const lines: Pt[][] = [poly([[cx - s * 0.6, top], [cx + s * 0.6, top], [cx + s * 0.42, bot], [cx - s * 0.42, bot]])];
        lines.push(poly([[cx - s * 0.18, top], [cx - s * 0.13, bot]], false), poly([[cx + s * 0.18, top], [cx + s * 0.13, bot]], false));
        const pop: Pt[] = [];
        for (let k = 0; k <= 4; k++) {
          const bx = cx - s * 0.6 + (k * s * 1.2) / 4;
          for (let m = 0; m <= 5; m++) {
            const t = Math.PI + (m / 5) * Math.PI;
            pop.push([bx + Math.cos(t) * s * 0.17, top - s * 0.05 + Math.sin(t) * s * 0.22]);
          }
        }
        lines.push(pop);
        return lines;
      },
      // アプリ開発：</>
      (cx, cy, s) => [
        poly([[cx - s * 0.45, cy - s * 0.45], [cx - s * 0.95, cy], [cx - s * 0.45, cy + s * 0.45]], false),
        poly([[cx + s * 0.15, cy - s * 0.6], [cx - s * 0.15, cy + s * 0.6]], false),
        poly([[cx + s * 0.45, cy - s * 0.45], [cx + s * 0.95, cy], [cx + s * 0.45, cy + s * 0.45]], false),
      ],
      // アプリ開発：ノートパソコン（画面・台・画面の中のコード）
      (cx, cy, s) => [
        poly([[cx - s * 0.8, cy - s * 0.65], [cx + s * 0.8, cy - s * 0.65], [cx + s * 0.8, cy + s * 0.35], [cx - s * 0.8, cy + s * 0.35]]),
        poly([[cx - s * 1.05, cy + s * 0.55], [cx + s * 1.05, cy + s * 0.55], [cx + s * 0.85, cy + s * 0.38], [cx - s * 0.85, cy + s * 0.38]]),
        poly([[cx - s * 0.55, cy - s * 0.35], [cx - s * 0.1, cy - s * 0.35]], false),
        poly([[cx - s * 0.4, cy - s * 0.12], [cx + s * 0.35, cy - s * 0.12]], false),
        poly([[cx - s * 0.4, cy + s * 0.1], [cx + s * 0.1, cy + s * 0.1]], false),
      ],
      // アプリ開発：スマホ（本体・画面の線・ボタン）
      (cx, cy, s) => [
        rrect(cx - s * 0.45, cy - s * 0.85, s * 0.9, s * 1.7, s * 0.15),
        poly([[cx - s * 0.25, cy - s * 0.45], [cx + s * 0.25, cy - s * 0.45]], false),
        poly([[cx - s * 0.25, cy - s * 0.2], [cx + s * 0.1, cy - s * 0.2]], false),
        circ(cx, cy + s * 0.62, s * 0.09, 1.05, 8),
      ],
      // アプリ開発：歯車
      (cx, cy, s) => {
        const teeth = 8;
        const pts: Pt[] = [];
        for (let k = 0; k < teeth * 2; k++) {
          const r = k % 2 === 0 ? s * 0.75 : s * 0.55;
          const a0 = (k / (teeth * 2)) * TAU;
          const a1 = ((k + 1) / (teeth * 2)) * TAU;
          pts.push([cx + Math.cos(a0) * r, cy + Math.sin(a0) * r], [cx + Math.cos(a1) * r, cy + Math.sin(a1) * r]);
        }
        return [poly(pts), circ(cx, cy, s * 0.22, 1.05, 14)];
      },
      // 読書：開いた本（左右のページ・背・文字の線）
      (cx, cy, s) => {
        const lines: Pt[][] = [
          poly([[cx, cy - s * 0.45], [cx - s * 0.5, cy - s * 0.62], [cx - s * 1.05, cy - s * 0.5], [cx - s * 1.05, cy + s * 0.5], [cx - s * 0.5, cy + s * 0.38], [cx, cy + s * 0.55]]),
          poly([[cx, cy - s * 0.45], [cx + s * 0.5, cy - s * 0.62], [cx + s * 1.05, cy - s * 0.5], [cx + s * 1.05, cy + s * 0.5], [cx + s * 0.5, cy + s * 0.38], [cx, cy + s * 0.55]]),
        ];
        for (let k = 0; k < 3; k++) {
          const y = cy - s * 0.25 + k * s * 0.22;
          lines.push(poly([[cx - s * 0.85, y], [cx - s * 0.2, y - s * 0.06]], false), poly([[cx + s * 0.2, y - s * 0.06], [cx + s * 0.85, y]], false));
        }
        return lines;
      },
      // 読書：積んだ本（3冊）
      (cx, cy, s) => {
        const lines: Pt[][] = [];
        const books: [number, number, number][] = [[-0.1, 0.45, 1.7], [0.08, 0.05, 1.5], [-0.05, -0.33, 1.3]];
        for (const [dx, dy, w] of books) {
          const x = cx + dx * s - (w * s) / 2, y = cy + dy * s;
          lines.push(poly([[x, y], [x + w * s, y], [x + w * s, y + s * 0.36], [x, y + s * 0.36]]));
          lines.push(poly([[x + s * 0.18, y], [x + s * 0.18, y + s * 0.36]], false));
        }
        return lines;
      },
      // 読書：メガネ
      (cx, cy, s) => [
        circ(cx - s * 0.5, cy, s * 0.36, 1.05, 22),
        circ(cx + s * 0.5, cy, s * 0.36, 1.05, 22),
        poly([[cx - s * 0.15, cy - s * 0.05], [cx, cy - s * 0.16], [cx + s * 0.15, cy - s * 0.05]], false),
        poly([[cx - s * 0.86, cy - s * 0.06], [cx - s * 1.15, cy - s * 0.2]], false),
        poly([[cx + s * 0.86, cy - s * 0.06], [cx + s * 1.15, cy - s * 0.2]], false),
      ],
    ];
    let bag: number[] = [];
    function make(): Pt[][] {
      const [cx, cy] = place();
      const s = 26 + Math.random() * 18;
      // 同じ絵ばかりにならないよう、全種類を一巡してから次の巡に入る
      if (!bag.length) bag = DOODLES.map((_, i) => i).sort(() => Math.random() - 0.5);
      return DOODLES[bag.pop()!](cx, cy, s);
    }
    function newSet() {
      const n = W < 640 ? 6 : Math.max(8, Math.min(16, Math.round((W * H) / 70000)));
      used = [];
      doodles = Array.from({ length: n }, () => ({ lines: make(), li: 0, pi: 1, w: 1 + Math.random() * 1.2, accent: Math.random() < 0.18 }));
      cur = 0;
      hold = 0;
      erase = 0;
    }
    function stroke(d: Doodle, a: Pt, b: Pt) {
      const col = d.accent ? accent() : ink();
      // 鉛筆らしく、少しずらして2回なぞる
      for (let k = 0; k < 2; k++) {
        ctx!.strokeStyle = `rgba(${col},${k === 0 ? 0.55 : 0.25})`;
        ctx!.lineWidth = d.w * (k === 0 ? 1 : 0.7);
        ctx!.beginPath();
        ctx!.moveTo(a[0] + j(0.8), a[1] + j(0.8));
        ctx!.lineTo(b[0] + j(0.8), b[1] + j(0.8));
        ctx!.stroke();
      }
    }
    return {
      init() {
        ctx!.clearRect(0, 0, W, H);
        ctx!.lineCap = 'round';
        newSet();
      },
      frame() {
        if (erase > 0) {
          // 消しゴム：少しずつ透明に戻す
          ctx!.save();
          ctx!.globalCompositeOperation = 'destination-out';
          ctx!.fillStyle = 'rgba(0,0,0,0.07)';
          ctx!.fillRect(0, 0, W, H);
          ctx!.restore();
          if (--erase === 0) {
            ctx!.clearRect(0, 0, W, H);
            newSet();
          }
          return;
        }
        if (cur >= doodles.length) {
          // 描き終わったら少し眺めてから消す
          if (++hold > 240) erase = 60;
          return;
        }
        let budget = 5; // 1フレームに描く線分の数（描く速さ）
        while (budget-- > 0 && cur < doodles.length) {
          const d = doodles[cur];
          const line = d.lines[d.li];
          stroke(d, line[d.pi - 1], line[d.pi]);
          d.pi++;
          if (d.pi >= line.length) {
            d.li++;
            d.pi = 1;
            if (d.li >= d.lines.length) cur++;
          }
        }
      },
      /** 動きを減らす設定の人向け：全部を一度に描く */
      drawAll() {
        for (const d of doodles) for (const line of d.lines) for (let i = 1; i < line.length; i++) stroke(d, line[i - 1], line[i]);
        cur = doodles.length;
      },
    };
  })();

  // ---- 切り替え・再生の制御 --------------------------------------------------
  const MODES = { sketch, flow, particles, voronoi, fractal } as const;
  const isMode = (m: string | null): m is Mode => !!m && m in MODES;
  // スケッチ風テーマのときは鉛筆の落書きを標準に
  let mode: Mode = document.documentElement.classList.contains('sketch') ? 'sketch' : 'flow';
  {
    const fromUrl = new URLSearchParams(location.search).get('bg');
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('bg-mode-v2');
    } catch {}
    if (isMode(fromUrl)) mode = fromUrl;
    else if (isMode(saved)) mode = saved;
  }

  let raf = 0;
  let visible = true;
  let lastFrame = 0;

  function loop(t: number) {
    raf = requestAnimationFrame(loop);
    // ボロノイ・フラクタルは重いので、30fps 程度に間引く
    if ((mode === 'voronoi' || mode === 'fractal') && t - lastFrame < 33) return;
    lastFrame = t;
    MODES[mode].frame(t);
  }
  function stop() {
    cancelAnimationFrame(raf);
    raf = 0;
  }
  function start() {
    if (!ctx || !canvas) return;
    stop();
    resize();
    ctx.clearRect(0, 0, W, H);
    MODES[mode].init();
    if (reduceMotion) {
      // 動きを減らす設定の人には、止まった1枚の絵を出す（流れ場は少し進めて線を描いておく）
      if (mode === 'sketch') sketch.drawAll();
      else {
        const steps = mode === 'flow' ? 220 : 1;
        for (let i = 0; i < steps; i++) MODES[mode].frame(i * 16);
      }
      return;
    }
    if (visible && !document.hidden) raf = requestAnimationFrame(loop);
  }
  function select(m: Mode) {
    mode = m;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.bg === m)));
    try {
      localStorage.setItem('bg-mode-v2', m);
    } catch {}
    start();
  }

  if (canvas && ctx) {
    buttons.forEach((b) => b.addEventListener('click', () => select(b.dataset.bg as Mode)));
    select(mode);
    // 画面外・別タブのときは止める（電池と CPU の節約）
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !raf && !reduceMotion) raf = requestAnimationFrame(loop);
      if (!visible) stop();
    }).observe(canvas);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (visible && !raf && !reduceMotion) raf = requestAnimationFrame(loop);
    });
    let rt = 0;
    new ResizeObserver(() => {
      clearTimeout(rt);
      rt = window.setTimeout(start, 150);
    }).observe(canvas);
    // テーマを切り替えたら描き直す
    new MutationObserver(start).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    const section = canvas.parentElement!;
    section.addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = e.clientX - r.left;
      pointer.y = e.clientY - r.top;
    });
    section.addEventListener('pointerleave', () => {
      pointer.x = pointer.y = -9999;
    });
  }
</script>
